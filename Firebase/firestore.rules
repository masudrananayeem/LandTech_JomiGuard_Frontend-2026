rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(userId) { return signedIn() && request.auth.uid == userId; }
    match /users/{userId} {
      allow read: if isSelf(userId) || (signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
      allow create: if isSelf(userId) && request.resource.data.role == 'user';
      allow update: if isSelf(userId) && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }
    // Land records are deny-by-default until collection-specific owner/admin rules are reviewed.
    match /{document=**} { allow read, write: if false; }
  }
}
